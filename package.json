{
  "name": "human-approval-authority",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:protocol": "npm run build -w @haa/protocol",
    "build:sdk": "npm run build:protocol && npm run build -w @haa/sdk",
    "build:packages": "npm run build:protocol && npm run build -w @haa/sdk",
    "pack:check": "npm run build:packages && npm pack --dry-run -w @haa/protocol && npm pack --dry-run -w @haa/sdk",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:core": "node --experimental-strip-types --test tests/core.test.ts",
    "test:service": "node --experimental-strip-types --test tests/service.test.ts",
    "test:mcp": "node --experimental-strip-types --test tests/mcp.test.ts",
    "check": "npm run build:packages && npm run test && npx tsc --noEmit",
    "validate:macos": "node scripts/validate-macos-e2e.mjs",
    "validate:agent-macos": "node scripts/validate-agent-macos-e2e.mjs",
    "provision:client": "node --experimental-strip-types scripts/provision-client.mjs",
    "rotate:client": "node --experimental-strip-types scripts/rotate-client.mjs",
    "disable:client": "node --experimental-strip-types scripts/disable-client.mjs",
    "rotate:authority-key": "node --experimental-strip-types scripts/rotate-authority-key.mjs",
    "checkpoint:audit": "node --experimental-strip-types scripts/checkpoint-audit.mjs",
    "verify:audit": "node --experimental-strip-types scripts/verify-audit.mjs",
    "backup:instance": "node --experimental-strip-types scripts/backup-instance.mjs",
    "verify:backup": "node --experimental-strip-types scripts/verify-backup.mjs",
    "restore:instance": "node --experimental-strip-types scripts/restore-instance.mjs",
    "start": "node --experimental-strip-types apps/haa-server/src/server.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
